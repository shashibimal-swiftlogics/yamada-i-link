# Server-only email settings. Leave unset to keep sending disabled.
# Use a verified sender in your own Resend account. Never commit real values.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
# At least 20 random characters. Authorized demo operators enter this in the UI.
# This is separate from the public demo PIN 1234. Do not use NEXT_PUBLIC_ variables.
ORDER_EMAIL_ACCESS_CODE=
